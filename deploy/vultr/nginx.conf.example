# Add this as a dedicated vhost in the EXISTING Baota Nginx installation.
# Do not replace nginx.conf or another site's vhost. Install the TLS sections
# only after both names are on the certificate; see docs/vultr-deployment.md.

server {
    listen 80;
    server_name gptplusapp.com www.gptplusapp.com;

    location ^~ /.well-known/acme-challenge/ {
        root /www/wwwroot/gptplusapp.com;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://www.gptplusapp.com$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name gptplusapp.com;

    ssl_certificate /etc/letsencrypt/live/gptplusapp.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gptplusapp.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 308 https://www.gptplusapp.com$request_uri;
}

server {
    listen 443 ssl;
    server_name www.gptplusapp.com;

    ssl_certificate /etc/letsencrypt/live/gptplusapp.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gptplusapp.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:3068;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering off;

        # No additional shared response cache, especially for APIs and billing.
        # Pass Next.js Cache-Control, CSP and other response headers unchanged;
        # hashed static assets retain Next.js's browser-cache policy.
        proxy_cache off;
    }
}
