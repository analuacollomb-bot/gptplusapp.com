[Unit]
Description=GPT Plus App website
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=gptplusapp
Group=gptplusapp
WorkingDirectory=/opt/gptplusapp/current
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3068
Environment=NODE_OPTIONS=--max-old-space-size=768
ExecStart=/opt/gptplusapp/runtime/current/bin/node server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
SyslogIdentifier=gptplusapp
UMask=0027
MemoryMax=1G
TasksMax=128

# Apply isolation only to this unit. Next.js needs a writable build/cache tree.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gptplusapp/current/.next
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
